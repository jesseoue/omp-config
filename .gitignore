# omp-config

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Secrets — never commit real keys
.env
.env.*
*.env
!env.example
!.env.example

# omp runtime state (never commit sessions/backups/logs)
.omp/
~/.omp/
*.log
*.bak
*.tmp
*.swp

# omp writes settings through the symlink and drops lockfiles next to the
# real files — runtime junk, never commit
*.yml.lock
mcp.json.lock

# Editor / IDE
.vscode/
.idea/
*.iml

# Node / Python (in case tooling is added later)
node_modules/
__pycache__/
*.pyc
.venv/
venv/