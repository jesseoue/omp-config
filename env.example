# omp-config — environment template
# Copy to ~/.omp/agent/.env and fill in your key.

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: OpenRouter app title for usage attribution
OPENROUTER_APP_TITLE=omp-config

# Optional: HTTP referer for OpenRouter attribution
OPENROUTER_HTTP_REFERER=https://github.com/jesseoue/omp-config