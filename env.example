# omp-config — environment template (HIGHLY OPTIMIZED)
# Copy to ~/.omp/agent/.env and fill in your keys.
#
# Only OPENROUTER_API_KEY is strictly required. CONTEXT7_API_KEY unlocks the
# Context7 MCP server (mcp.json) for live, up-to-date library docs.

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Context7 API key (https://context7.com/dashboard) — powers the Context7 MCP
# server (mcp.json) for up-to-date library docs. Optional but recommended.
CONTEXT7_API_KEY=

# Optional: OpenRouter app title for usage attribution
OPENROUTER_APP_TITLE=omp-config

# Optional: HTTP referer for OpenRouter attribution
OPENROUTER_HTTP_REFERER=https://github.com/jesseoue/omp-config

# Optional: OpenRouter performance/routing preferences (if supported by omp).
# These mirror the routing hints in models.yml and bias every request toward
# the fastest healthy endpoint while keeping automatic failover.
# OPENROUTER_PROVIDER_SORT=throughput
# OPENROUTER_PREFERRED_MAX_LATENCY_P90=3
# OPENROUTER_PREFERRED_MIN_THROUGHPUT_P50=50

# Frontier reasoning toggle (plan/slow roles). Choose the model used for hard
# problems and deep reasoning:
#   deepseek  -> deepseek/deepseek-v4-pro-0813  (open-weight, default, cheaper)
#   opus      -> anthropic/claude-opus-5        (closed frontier)
# Leave unset or set to "deepseek" for the open-weight default.
FRONTIER_MODEL=deepseek